# ─────────────────────────────────────────────────────────────────
# SafeStep Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# --- API Server ---
SAFESTEP_API_HOST=0.0.0.0
SAFESTEP_API_PORT=8000

# --- Device ---
# Options: auto | cpu | cuda | mps
SAFESTEP_DEVICE=auto

# --- Checkpoint paths ---
SAFESTEP_CART_CHECKPOINT=checkpoints/cart
SAFESTEP_JAW_CHECKPOINT=checkpoints/jaw
# Phishing pipeline: attack.joblib + beast.json (+ optional warhammer.pt)
SAFESTEP_PHISHING_CHECKPOINT=checkpoints/phishing

# --- Security ---
# Comma-separated browser origins allowed by CORS (unset = "*", empty = none)
# SAFESTEP_CORS_ORIGINS=https://app.example.com
# Serve randomly initialised "mock" models when checkpoints are missing (dev only)
SAFESTEP_MOCK_FALLBACK=false

# --- Decision threshold overrides ---
# SAFESTEP_CART_THRESHOLD=0.5
# SAFESTEP_JAW_THRESHOLD=0.5
# SAFESTEP_PHISHING_THRESHOLD=0.5

# ─────────────────────────────────────────────────────────────────
# ADMIN / TRAINING TOKEN
# A long random secret required (X-Admin-Token header) for POST /models/{id}/reload.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Distribute manually and only to trusted operators.
# ─────────────────────────────────────────────────────────────────
SAFESTEP_ADMIN_TOKEN=replace_me_with_a_secure_random_token
